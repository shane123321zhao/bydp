# 正式环境配置模板（PO #23）——只有键名与说明，不含任何值。
# 用法：复制到你电脑 ~/bydp-keys/prod.env.input → 用「文本编辑」打开 → 逐行把值粘贴到等号后面 → 保存 → 对开发说「#23 done」。
#       开发只上传到正式机（scripts/push-env-input.sh prod），不查看内容；本文件填好后不要贴进任何会话、mailbox 或 git。
# 已预填的是非密钥配置（可按需修改）；空着的需要你填。不要加引号以外的空格。

# ── 站点（#21 定域名后填）────────────────────────────
# 正式主站域名，不带 https://，例：northx.vip
SITE_DOMAIN=
# 后台独立子域，例：admin.northx.vip（正式环境必填；与主站不能相同）
ADMIN_HOST=
# 正式站必须在 Cloudflare 后（橙云）。保持 1
BYDP_BEHIND_CLOUDFLARE=1

# ── Telegram（前台 Bot：裁定沿用 @BYDP_001_bot）──────────
# 去哪儿复制：你电脑项目目录 .env.local 第 2 行 TELEGRAM_BOT_TOKEN= 后面那串（同一个 Bot，直接复制）
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=BYDP_001_bot

# ── 后台 Bot（#17）────────────────────────────────
# 去哪儿复制：#17 在 @BotFather /newbot 后给你的 token（也可从 .env.local 的 ADMIN_TG_BOT_TOKEN 复制）
ADMIN_TELEGRAM_BOT_TOKEN=
# 后台 Bot 用户名，不带 @，例：BYDP_admin_bot
ADMIN_TELEGRAM_BOT_USERNAME=

# ── 邮件（Resend）─────────────────────────────────
# 去哪儿复制：resend.com → API Keys → Create API Key（名称 bydp-prod，权限 Sending access，Domain 选 mail.northx.vip）→ 复制
# 建议正式站单独建一个，测试站那个泄露不影响正式站；暂时也可复制 .env.local 的 RESEND_API_KEY
RESEND_API_KEY=
EMAIL_FROM="BYDP 博弈点评 <no-reply@mail.northx.vip>"

# ── Cloudflare R2（正式站用自己的两个桶，不与测试站共用）────
# 先在 Cloudflare → R2 → Create bucket 建两个桶：bydp-prod-evidence、bydp-prod-backup（名字不同就改下面两行）
R2_BUCKET_EVIDENCE=bydp-prod-evidence
R2_BUCKET_BACKUP=bydp-prod-backup
# 去哪儿复制：R2 页面右侧「Account details」里的 S3 API 端点，形如 https://<账户ID>.r2.cloudflarestorage.com（与 .env.local 的 R2_ENDPOINT 相同）
R2_ENDPOINT=
# 证据令牌：R2 → Manage R2 API Tokens → Create API token，名称 bydp-prod-evidence，Object Read & Write，只选 bydp-prod-evidence → 复制两项
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# 备份写令牌：同上再建一个，名称 bydp-prod-backup-writer，Object Read & Write，只选 bydp-prod-backup → 复制两项（不得与证据令牌相同）
R2_BACKUP_ACCESS_KEY_ID=
R2_BACKUP_SECRET_ACCESS_KEY=
# （第三个只读恢复令牌 bydp-prod-backup-restore 不放这里，填进你电脑 ~/bydp-keys/restore.env，见 go-live.md「备份」第 4 步）

# ── 备份加密公钥（#18）────────────────────────────
# 去哪儿复制：#18 生成密钥时屏幕上 Public key: 后面 age1 开头那一串（公钥，不是私钥）
BACKUP_AGE_RECIPIENT=

# ── Cloudflare Access（后台子域；均非密钥）────────────────
# 去哪儿复制：docs/ops/cloudflare-access.md 第 4 节（Zero Trust → Settings → Team domain；Access 应用 → Overview → Application Audience (AUD) Tag）
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# ── Authenticated Origin Pulls（可选，上线后按 cloudflare-access.md 6b 节再开）──
CF_AOP_ENABLED=0
