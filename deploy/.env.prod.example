# deploy/.env.prod 全量键说明（D-020 #4 · HANDOVER §9 #7 / #9 / #15）。
# 真实 .env.prod 由 bootstrap.sh 首次运行时生成（600，不入库、不外传、不贴进任何会话）；本文件只说明每个键，**不放任何值**。
# 来源标记：[生成] bootstrap 随机生成 · [输入] 来自 .env.prod.input（PO 提供，见 env.prod.input.example）· [派生] bootstrap 计算 · [固定] 固定值

# ---------- 环境 ----------
BYDP_ENV=                 # [生成] staging | production（bootstrap 不带参数 = staging；--prod = production；与已有 .env.prod 不一致即拒绝）
BYDP_TRUST_PROXY=         # [固定] 1：只信 Caddy 下发的 CF-Connecting-IP（Caddy 已按 Cloudflare 回源段校验）
SCORING_DAILY_ENABLED=    # [固定] false；仅在方案 A demo 核对通过且为正式库时由 PO 决定开启（§9 #7）
# SCORING_TZ=Asia/Shanghai  # 开启每日评分时设置（§9 #7）
# BYDP_DEV_SESSION=        # 必须不存在：正式环境出现即拒绝部署；api 在非开发环境也拒绝启动

# ---------- 数据库（compose 内网；DB 时区 UTC，启动检查 + 每日巡检） ----------
POSTGRES_PASSWORD=        # [生成] owner（bydp_owner），只用于迁移 / seed
DB_APP_PASSWORD=          # [生成] bydp_app：web / api / worker / tg-bot
DB_SCORING_RO_PASSWORD=   # [生成] bydp_scoring_ro：评分只读
DB_AGENT_PASSWORD=        # [生成] bydp_agent：Agent 任务（连接数 5、单语句 30 秒）

# ---------- 登录与加密（轮换会使全部会话 / 密文失效，须走轮换流程） ----------
AUTH_SECRET=              # [生成] Auth.js 会话加密
IDENTITY_HMAC_KEY=        # [生成] 身份盲索引（含 Candidate 去刷 HKDF 派生）
AUTH_PII_KEY=             # [生成] 联系方式 / 绑定账号加密
BINDING_HMAC_KEY=         # [生成] 绑定账号盲索引
TG_WEBHOOK_SECRET=        # [生成] Telegram webhook 校验

# ---------- 搜索（Meilisearch，仅内网） ----------
MEILI_MASTER_KEY=         # [生成] 只给 worker（compose 中其他服务置空）
MEILI_SEARCH_KEY=         # [派生] HMAC(master, 固定 uid) 只读 key：web / api / tg-bot

# ---------- 站点与后台 ----------
SITE_DOMAIN=              # [输入] 主站域名
AUTH_URL=                 # [派生] https://SITE_DOMAIN
ADMIN_HOST=               # [输入] 后台独立子域（正式环境必填；测试站留空 = /admin 路径）
ADMIN_TELEGRAM_BOT_TOKEN= # [输入] 可选：后台专用 Bot（TG 登录组件一个 Bot 只能绑一个域名）
ADMIN_TELEGRAM_BOT_USERNAME= # [输入] 可选
ADMIN_PATHS_ON_MAIN=      # [派生] 测试站 "/admin /admin/*"；配置 ADMIN_HOST 后为不可达路径（主站不再转发后台）
BYDP_BEHIND_CLOUDFLARE=   # [输入] 1 = 已在 Cloudflare 后（正式环境）
CF_ACCESS_TEAM_DOMAIN=    # [输入] Access 团队域名 <团队>.cloudflareaccess.com（#30；配 ADMIN_HOST 时必填，非密钥）
CF_ACCESS_AUD=            # [输入] 后台 Access 应用的 AUD（64 位十六进制，非密钥）
CF_AOP_ENABLED=           # [输入] 1 = 源站只接受带我方 zone 回源证书的 TLS 连接（#31，默认 0）；为 1 时须有 deploy/aop-ca.pem
CF_TRUSTED_PROXIES=       # [派生] Cloudflare 回源段（在线拉取，失败用 cloudflare-ips.txt）；未接入 Cloudflare 时 127.0.0.1/32
# GEO_BLOCK_COUNTRIES=CN  # 可选：应用层 451 屏蔽国家（默认 CN）

# ---------- 测试站专用（正式环境不生成） ----------
STAGING_GATE_PASSWORD=       # [生成] 测试站门禁口令（PO 在口令页输入；W2#010 起取代 Basic Auth）
STAGING_GATE_TOKEN=          # [生成] 门禁 Cookie 值（64 位十六进制，Caddy 正则匹配；UAT 直接注入）
UAT_MAILBOX_LOCALPART=       # [开发写入] PO #26 UAT 测试邮箱的本地部分（@ 之前，非密钥）；UAT 工具只认它的 +uat 别名，未设置即拒绝（W2#013）

# ---------- 第三方（PO 提供，用文本编辑器填入 .env.prod.input） ----------
TELEGRAM_BOT_TOKEN=       # [输入] @BYDP_001_bot：登录 / 通知 / Bot / 告警推送
TELEGRAM_BOT_USERNAME=    # [输入]
RESEND_API_KEY=           # [输入] 邮件（magic link / 通知）
EMAIL_FROM=               # [输入] 例 "BYDP 博弈点评 <no-reply@mail.northx.vip>"
R2_ACCESS_KEY_ID=         # [输入] Cloudflare R2（证据原文 + 备份）
R2_SECRET_ACCESS_KEY=     # [输入]
R2_ENDPOINT=              # [输入]
R2_BUCKET_EVIDENCE=       # [输入] bydp-evidence
R2_BUCKET_BACKUP=         # [输入] bydp-backup
R2_BACKUP_ACCESS_KEY_ID=  # [输入] 备份专用令牌（只授权备份桶；正式环境必填、不得与证据令牌相同）
R2_BACKUP_SECRET_ACCESS_KEY= # [输入]
BACKUP_AGE_RECIPIENT=     # [输入] age 公钥（age1…，非密钥）；私钥 PO 离线保管，不进服务器
BACKUP_EXPECTED=          # [派生] 配置了备份桶时为 1：worker 每日巡检超过 26 小时无成功备份即告警

# ---------- 告警与监控（§9 #15） ----------
# alert 级事件（postback 配置事故、维护任务失败、搜索重建失败、磁盘 < 25GB、DB 时区异常）→ Telegram 推送给所有 admin 角色账号
#   复用 TELEGRAM_BOT_TOKEN，无需新键；admin 账号须已在 Telegram 里给 @BYDP_001_bot 发过 /start。
# DISK_ALERT_GB=           # 磁盘告警阈值 GB：正式环境不设（默认 25）；测试站 bootstrap 写 15
# Sentry：P1 不接入（协调官 D-020 裁定）

# ---------- Agent（默认关） ----------
# AGENT_CRAWL_ENABLED=1    # 站点监控 / 采集抓取；首批真实品牌入库后由 PO 决定（§9 #25），演示数据下不得开启
