# 模板：复制为 deploy/.env.prod.input（600）后填写，或用 scripts/push-env-input.sh 校验后经 SSH 上传。不入库。
# 下面的域名 / Bot 用户名为示例，换成你自己的。
SITE_DOMAIN=staging.example.com
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=your_bydp_bot
# 测试站专用 Bot（只在测试站填；正式环境填了会拒绝部署）。填了即覆盖上面两行，可用 scripts/staging-bot.sh 从 .env.local 写入
STAGING_TELEGRAM_BOT_TOKEN=
STAGING_TELEGRAM_BOT_USERNAME=
RESEND_API_KEY=
EMAIL_FROM="BYDP 博弈点评 <no-reply@mail.example.com>"
# Cloudflare R2（证据原文 + 备份）
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_EVIDENCE=bydp-evidence
R2_BUCKET_BACKUP=bydp-backup
# D-020 #2：站点已在 Cloudflare 后（DNS 橙云代理）时填 1——Caddy 只信任 Cloudflare 回源段的 CF-Connecting-IP / CF-IPCountry；
# 测试站不经 Cloudflare，留空或 0（Caddy 不信任任何代理，客户端自带的 CF-* 头一律丢弃）
BYDP_BEHIND_CLOUDFLARE=0
# D-020 #3：后台独立子域（正式环境填，如 admin.example.com；测试站留空 = 维持 /admin 路径 + Cookie 门禁）。
# 后台要用 Telegram 登录须另建 Bot 并 /setdomain 到该子域（一个 Bot 只能绑一个域名）；不填则后台只用邮箱登录
ADMIN_HOST=
ADMIN_TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_BOT_USERNAME=
# D-020 #30：后台子域 Cloudflare Access JWT 校验（配置 ADMIN_HOST 时必填；均非密钥，见 docs/ops/cloudflare-access.md 第 4 节）
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# D-020 #7：备份加密公钥（age1…，在你自己的电脑上生成，私钥离线保管，见 deploy/README.md 第 2 节与 docs/ops/go-live.md「备份」）；未配置时备份拒绝上传
BACKUP_AGE_RECIPIENT=
# 备份专用 R2 令牌（只授权备份桶；正式环境必填且不得与上面的证据令牌相同；测试站可留空沿用证据令牌）
R2_BACKUP_ACCESS_KEY_ID=
R2_BACKUP_SECRET_ACCESS_KEY=
# D-020 #31：Authenticated Origin Pulls（正式环境接入 Cloudflare 后，见 docs/ops/cloudflare-access.md 6b 节）；为 1 时须有 deploy/aop-ca.pem
CF_AOP_ENABLED=0
