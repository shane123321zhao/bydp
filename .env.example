# ---- 数据库 ----
DATABASE_URL=postgres://bydp:pass@localhost:5432/bydp
DATABASE_URL_SCORING_RO=postgres://bydp_scoring_ro:pass@localhost:5432/bydp   # 只读角色，仅 GRANT 信任域表（ADR-0006）
# ---- 评分任务（默认关闭，D-004）----
SCORING_DAILY_ENABLED=false
SCORING_TZ=Asia/Shanghai
# ---- 缓存 / 队列 / 搜索 ----
REDIS_URL=redis://localhost:6379
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=
# ---- 对象存储（R2）----
S3_ENDPOINT=
S3_BUCKET=bydp-evidence
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# ---- 绑定盲索引（HMAC-SHA256，≥32 字符随机串；只放环境变量，轮换需重算全部 hash）----
BINDING_HMAC_KEY=
# ---- 身份 ----
AUTH_SECRET=
# A-009：站点根 URL（magic link 只按它生成与校验，防 Host 头投毒）。部署环境必填，例：https://northx.vip
AUTH_URL=
# 部署在 Cloudflare → Caddy 之后且源站只接受 Cloudflare 回源时设为 1（才读 CF-Connecting-IP 做限流）。部署环境必填
BYDP_TRUST_PROXY=
# Auth.js 接入前的本地会话（X-Dev-User: u_xxx）。只在 NODE_ENV=development|test 或 BYDP_ENV=local 时允许开启，其他环境开启即拒绝启动
BYDP_DEV_SESSION=
# 运营商 postback 验签密钥：operator_integration.postbackSecretRef 指向的变量名，必须以 POSTBACK_SECRET_ 开头，值 ≥ 32 字符（例：POSTBACK_SECRET_JINLONG=）
TELEGRAM_BOT_TOKEN=
# 非密钥：TG 机器人用户名（Login Widget data-telegram-login）
TELEGRAM_BOT_USERNAME=
# A-009：登录身份盲索引 HMAC 密钥 / 联系方式 AES-256-GCM 密钥（均为 32 字节 base64，openssl rand -base64 32）
IDENTITY_HMAC_KEY=
AUTH_PII_KEY=
# magic link 发信：Resend API key（仅发送权限即可）+ 发信地址（须为 Resend 已验证域名，非密钥）
RESEND_API_KEY=
EMAIL_FROM=
TELEGRAM_LOGIN_BOT=
EMAIL_FROM=
# ---- Agent ----
ANTHROPIC_API_KEY=
# ---- 边缘 ----
GEO_BLOCK_COUNTRIES=CN

# ---------- 运维脚本（开发机，非密钥；scripts/deploy.sh · uat.sh · staging-bot.sh · push-env-input.sh 读取）----------
# 测试站服务器 IPv4 与 SSH 私钥路径（私钥文件本身不进仓库）
BYDP_STAGING_HOST=
BYDP_STAGING_SSH_KEY=
# 正式服务器 SSH 私钥路径（缺省 ~/.ssh/bydp-prod.pem；IP 用 deploy.sh --host 传入）
BYDP_PROD_SSH_KEY=
# 测试站 UAT（scripts/uat.sh）：门禁 Cookie 值、UAT 专用测试邮箱与其 IMAP 应用专用密码（密钥，只填本机 .env.local）
STAGING_GATE_TOKEN=
UAT_IMAP_USER=
UAT_IMAP_APP_PASSWORD=
